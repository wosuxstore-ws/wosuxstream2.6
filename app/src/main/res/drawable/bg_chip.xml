<?xml version="1.0" encoding="utf-8"?>
<!-- Source chip on Home (TV / large screen): cyan ring when focused, tinted + thin cyan outline when it is the active source. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_focus" />
            <stroke android:width="3dp" android:color="@color/accent" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_focus" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/chip_selected" />
            <stroke android:width="1dp" android:color="@color/accent" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
